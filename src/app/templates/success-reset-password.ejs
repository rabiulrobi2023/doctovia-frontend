<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Changed Successfully</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: Arial, Helvetica, sans-serif;
      color: #333333;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f4f6f8; padding: 40px 20px"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 10px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  background-color: #16a34a;
                  padding: 25px;
                  text-align: center;
                "
              >
                <h1 style="margin: 0; color: #ffffff; font-size: 24px">
                  <%= appName %>
                </h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 40px 35px">
                <h2 style="margin: 0 0 20px; color: #222222; font-size: 22px">
                  Password Changed Successfully
                </h2>

                <p style="margin: 0 0 15px; font-size: 16px; line-height: 1.6">
                  Hello <strong><%= name %></strong>,
                </p>

                <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.6">
                  Your password has been successfully changed.
                </p>

                <!-- Information Box -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #f0fdf4;
                    border: 1px solid #bbf7d0;
                    border-radius: 8px;
                    margin: 25px 0;
                  "
                >
                  <tr>
                    <td style="padding: 18px">
                      <p
                        style="margin: 0 0 8px; font-size: 14px; color: #555555"
                      >
                        <strong>Changed at:</strong>
                        <%= changedAt %>
                      </p>

                      <p style="margin: 0; font-size: 14px; color: #555555">
                        <strong>Account:</strong>
                        <%= email %>
                      </p>
                    </td>
                  </tr>
                </table>

                <p style="margin: 0 0 15px; font-size: 15px; line-height: 1.6">
                  If you made this change, no further action is required.
                </p>

                <p style="margin: 0; font-size: 15px; line-height: 1.6">
                  If you did not change your password, please contact our
                  support team immediately and secure your account.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background-color: #f8fafc;
                  padding: 20px 35px;
                  text-align: center;
                "
              >
                <p style="margin: 0 0 8px; font-size: 13px; color: #777777">
                  This is an automated security notification.
                </p>

                <p style="margin: 0; font-size: 13px; color: #999999">
                  &copy; <%= new Date().getFullYear() %> <%= appName %>. All
                  rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
