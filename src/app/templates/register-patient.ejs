<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify Your Email</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f4f7fb;
  font-family: Arial, Helvetica, sans-serif;
  color: #333333;
">
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="padding: 40px 20px; background-color: #f4f7fb;"
  >
    <tr>
      <td align="center">

        <table
          width="600"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width: 600px;
            width: 100%;
            background-color: #ffffff;
            border-radius: 10px;
          "
        >

          <!-- Header -->
          <tr>
            <td
              align="center"
              style="
                padding: 30px 20px;
                background-color: #2563eb;
                border-radius: 10px 10px 0 0;
              "
            >
              <h1 style="
                margin: 0;
                color: #ffffff;
                font-size: 26px;
              ">
                Email Verification
              </h1>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 40px 35px;">

              <h2 style="
                margin: 0 0 20px;
                color: #111827;
                font-size: 22px;
              ">
                Hello <%= name %>,
              </h2>

              <p style="
                margin: 0 0 15px;
                font-size: 16px;
                line-height: 1.6;
                color: #4b5563;
              ">
                Thank you for registering as a patient with us.
              </p>

              <p style="
                margin: 0 0 25px;
                font-size: 16px;
                line-height: 1.6;
                color: #4b5563;
              ">
                Please use the verification code below to verify your email
                address and complete your registration.
              </p>

              <!-- OTP -->
              <div style="
                text-align: center;
                margin: 30px 0;
              ">
                <div style="
                  display: inline-block;
                  padding: 15px 30px;
                  background-color: #eff6ff;
                  border-radius: 8px;
                  color: #2563eb;
                  font-size: 32px;
                  font-weight: bold;
                  letter-spacing: 8px;
                ">
                  <%= otp %>
                </div>
              </div>

              <p style="
                margin: 0 0 20px;
                text-align: center;
                font-size: 14px;
                color: #6b7280;
              ">
                This verification code will expire in
                <strong><%= expirationMinutes %> minutes</strong>.
              </p>

              <p style="
                margin: 25px 0 0;
                font-size: 14px;
                line-height: 1.6;
                color: #6b7280;
              ">
                If you did not register for an account, you can safely ignore
                this email.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              align="center"
              style="
                padding: 20px;
                background-color: #f9fafb;
                border-radius: 0 0 10px 10px;
                color: #9ca3af;
                font-size: 12px;
              "
            >
              <p style="margin: 0;">
                This is an automated email. Please do not reply.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>